# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
CARTESIA_API_KEY=
# Set after running `npm run clone -- path/to/clip.wav`
CARTESIA_VOICE_ID=
# 1 = no network calls: canned replies, browser speechSynthesis for voice
MOCK_REPLIES=0
MOCK_VOICE=0
# claude-opus-5-5 by default; claude-haiku-5-5 if latency is too high
CLAUDE_MODEL=claude-opus-5-5
PORT=8787
