# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
CARTESIA_API_KEY=
# Set after running `npm run clone -- path/to/clip.wav`
CARTESIA_VOICE_ID=
# 1 = no network calls: canned replies, browser speechSynthesis for voice
MOCK_REPLIES=0
MOCK_VOICE=0
# claude-haiku-5-5 by default (fastest, ~1.2 s median); claude-opus-5-5 is slower
CLAUDE_MODEL=claude-haiku-5-5
PORT=8790
# Claude reply timeout before safe fallback replies (ms). Slow venue Wi-Fi needs more than the 3000 default.
REPLIES_TIMEOUT_MS=8000
# Background conversation summaries (patient "So far" and the care panel)
SUMMARY_MODEL=claude-opus-5-5
