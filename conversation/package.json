{
  "name": "blinkvoice-conversation",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "clone": "tsx --env-file-if-exists=.env scripts/clone-voice.ts",
    "typecheck": "tsc --noEmit",
    "eval": "tsx --env-file-if-exists=.env scripts/eval-phrases.ts",
    "eval:replies": "tsx --env-file-if-exists=.env scripts/eval-replies.ts",
    "chat": "tsx --env-file-if-exists=.env scripts/chat.ts",
    "local-model": "mkdir -p models && curl -L -o models/Qwen3-4B-Instruct-2507-Q4_K_M.gguf https://huggingface.co/unsloth/Qwen3-4B-Instruct-2507-GGUF/resolve/main/Qwen3-4B-Instruct-2507-Q4_K_M.gguf"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@cartesia/cartesia-js": "^4.2.0",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "node-llama-cpp": "^3.22.2"
  },
  "engines": {
    "node": ">=22.9"
  }
}
