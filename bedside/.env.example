PORT=8788

# Phase 1 runs with no model at all: rules classify the turn and the slot table fills the boxes.
# Set to 0 only once the LLM adapter lands (build step 5).
MOCK_LLM=1
LLM_BACKEND=ollama
LLM_URL=http://localhost:11434
LLM_MODEL=gemma3n:e4b

# Per-patient memory.md and session metrics. Never inside the repo: this is PHI.
BEDSIDE_DATA_DIR=./data

# Stubs for the orientation answer until memory.md lands (build step 6).
BEDSIDE_WHERE=
BEDSIDE_WHAT=
BEDSIDE_NEXT=
